{
  "name": "math-rescue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Math Rescue — card equation puzzle game",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/migrate.js",
    "test": "node --test tests/**/*.test.js",
    "test:e2e": "playwright test",
    "daily:generate": "node scripts/generate-daily-challenges.mjs",
    "build": "node scripts/sync-asset-version.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
